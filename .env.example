HOMEOPS_HOST=127.0.0.1
HOMEOPS_PORT=8000
HOMEOPS_PUBLIC_BASE_URL=http://127.0.0.1:8000

# MCP transport security. Replace with the real deployment host/origin.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# AWS Builder integration. Core HomeOps works with this disabled.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_PROFILE=
# Recommended low-cost Amazon model for this explanation task.
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
BEDROCK_MAX_TOKENS=120
BEDROCK_READ_TIMEOUT_SECONDS=90
